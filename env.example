# ===== SERVER CONFIGURATION =====
NODE_ENV=development
PORT=3000
APP_NAME=Smart Queue Management System
APP_URL=http://localhost:3000

# ===== AUTHENTICATION =====
JWT_SECRET=your-super-secret-jwt-key-change-in-production-32-chars-min
JWT_EXPIRY=24h
REFRESH_TOKEN_EXPIRY=7d

# ===== DATABASE =====
# Choose one: mongodb, mysql, postgresql

# MongoDB
DB_TYPE=mongodb
MONGODB_URI=mongodb://localhost:27017/queue-management
MONGODB_USER=admin
MONGODB_PASSWORD=password

# MySQL
# DB_TYPE=mysql
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=password
# MYSQL_DATABASE=queue_management

# PostgreSQL
# DB_TYPE=postgresql
# PG_HOST=localhost
# PG_PORT=5432
# PG_USER=postgres
# PG_PASSWORD=password
# PG_DATABASE=queue_management

# ===== FRONTEND CONFIGURATION =====
FRONTEND_URL=http://localhost:3000
FRONTEND_PROD_URL=https://your-queue-system.netlify.app

# ===== CORS =====
CORS_ORIGIN=*
# For production: "https://your-domain.com,https://www.your-domain.com"

# ===== EMAIL CONFIGURATION (Optional) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@yourcompany.com

# ===== SMS CONFIGURATION (Optional) =====
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ===== LOGGING =====
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# ===== RATE LIMITING =====
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===== EXTERNAL SERVICES =====
# AWS S3 (for storing QR codes, reports)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=queue-management-bucket

# Redis (for caching/sessions)
REDIS_URL=redis://localhost:6379

# Sentry (for error tracking)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ===== FEATURE FLAGS =====
ENABLE_SMS_NOTIFICATIONS=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_QR_CODE=true
ENABLE_ANALYTICS=true

# ===== PAYMENT (Optional) =====
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# ===== ADMIN SETTINGS =====
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=+1-555-000-0000
MAX_QUEUE_SIZE=100
APPOINTMENT_DURATION_MINUTES=20
COUNTER_COUNT=3
